# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Resend (phase 5)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Foreman <noreply@example.com>

# Stripe (phase 6)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Cron (phase 5) — Vercel sends `Authorization: Bearer ${CRON_SECRET}` on
# every scheduled invocation. Set the same value here.
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo seeder (scripts/seed-demo.mjs) — optional overrides for the full-access
# test account. Defaults: demo@foreman.app / ForemanDemo!2026. Run locally only.
DEMO_EMAIL=
DEMO_PASSWORD=

# Upstash Redis — backs rate limiting on user-facing API routes (5
# requests / 15 min per IP). If unset, rate limiting is disabled and a
# warning is logged. MUST be set in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
